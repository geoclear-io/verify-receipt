{
  "name": "@geoclear/verify-receipt",
  "version": "2.0.0",
  "description": "Verify GeoClear signed receipts and Evidence Bundles offline, against a JWKS you trust: ES384 signatures, request and response hashes, and the ML-DSA-87 layer of hybrid bundles. Verifies signatures and integrity, never decisions.",
  "main": "verify.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "geoclear-verify-receipt": "cli.js"
  },
  "files": [
    "verify.js",
    "cli.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node cli.js"
  },
  "keywords": [
    "geoclear",
    "verify-receipt",
    "jws",
    "ecdsa-p384",
    "ml-dsa-87",
    "evidence-bundle"
  ],
  "capabilities": [
    "ecdsa-p384",
    "ml-dsa-87",
    "hybrid-evidence-bundle",
    "ecdsa-chain-anchored-mldsa-pubkey-fingerprint-binding",
    "independent-trust-source",
    "key-metadata-enforcement",
    "v5_1-policy-bundle-shape-validation"
  ],
  "dependencies": {
    "jose": "^5.10.0",
    "@noble/post-quantum": "^0.6.1",
    "adm-zip": "^0.5.16"
  },
  "license": "MIT",
  "author": "GeoClear, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoclear-io/verify-receipt.git"
  },
  "bugs": {
    "url": "https://github.com/geoclear-io/verify-receipt/issues"
  },
  "homepage": "https://github.com/geoclear-io/verify-receipt#readme"
}
