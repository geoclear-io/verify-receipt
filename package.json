{
  "name": "@geoclear/verify-receipt",
  "version": "1.1.1",
  "description": "Verify GeoClear signed decision receipts offline. Proves what GeoClear returned at what moment, without calling GeoClear. v1.1.1 — repo metadata moved to geoclear-io org (no API changes).",
  "type": "commonjs",
  "main": "src/verify.js",
  "exports": {
    ".": {
      "require": "./src/verify.js",
      "types": "./src/verify.d.ts"
    }
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "keywords": [
    "geoclear",
    "signed-receipts",
    "jws",
    "ecdsa",
    "audit-trail",
    "address-api",
    "cryptographic-attestation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoclear-io/verify-receipt.git"
  },
  "homepage": "https://geoclear.io/security#receipt-demo",
  "bugs": {
    "url": "https://github.com/geoclear-io/verify-receipt/issues"
  },
  "author": "Auduu Inc <hello@geoclear.io>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
